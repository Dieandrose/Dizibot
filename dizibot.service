[Unit]
Description=DiziBot - Otonom Telegram Medya Dağıtım ve Takip Botu
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/dizibot
ExecStart=/root/Darkbox/.venv/bin/python /root/dizibot/main.py
Restart=always
RestartSec=10
StandardOutput=append:/root/dizibot/data/dizibot.log
StandardError=append:/root/dizibot/data/dizibot.log

[Install]
WantedBy=multi-user.target
